const {
    app,
    BrowserWindow
} = require("electron");

const path = require("path");
const { spawn } = require("child_process");

let mainWindow;
let pythonProcess;

function startPythonBackend() {
    const projectRoot = path.resolve(__dirname, "..");

    pythonProcess = spawn(
        path.join(projectRoot, ".venv", "bin", "python"),
        ["-m", "api.server"],
        {
            cwd: projectRoot,
            stdio: "inherit"
        }
    );

    pythonProcess.on("error", (error) => {
        console.error(
            "[NOVA] Python backend error:",
            error
        );
    });
}

function createWindow() {
    mainWindow = new BrowserWindow({
        width: 1400,
        height: 900,

        minWidth: 1100,
        minHeight: 700,

        backgroundColor: "#05070B",

        webPreferences: {
            preload: path.join(
                __dirname,
                "preload.js"
            ),

            contextIsolation: true,
            nodeIntegration: false
        }
    });

    mainWindow.loadFile(
        path.join(
            __dirname,
            "index.html"
        )
    );
}

app.whenReady().then(() => {

    startPythonBackend();

    setTimeout(() => {
        createWindow();
    }, 1200);

    app.on("activate", () => {

        if (
            BrowserWindow.getAllWindows()
                .length === 0
        ) {
            createWindow();
        }

    });

});

app.on("window-all-closed", () => {

    if (process.platform !== "darwin") {
        app.quit();
    }

});

app.on("before-quit", () => {

    if (pythonProcess) {

        pythonProcess.kill();

        pythonProcess = null;
    }

});
